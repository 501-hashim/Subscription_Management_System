# ==============================================================================
# Brightloop Subscription Management System - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development
DEBUG=true

# Database Configuration (PostgreSQL)
# Local Docker or Local PostgreSQL instance:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/brightloop_subscription_db

# Examples for Hosted PostgreSQL Providers (copy your provider connection string):
# Neon PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@ep-rapid-pool-123456.us-east-2.aws.neon.tech/brightloop_subscription_db?sslmode=require
# Render PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@dpg-xxxxxx.oregon-postgres.render.com/brightloop_subscription_db?sslmode=require
# AWS RDS / Azure PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@my-pg-instance.postgres.database.azure.com:5432/brightloop_subscription_db?sslmode=require

# Security Keys
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External Services
RESEND_API_KEY=re_your_api_key_here
FRONTEND_URL=http://localhost:5173

# Database Connection Pooling Options (Tuned for production performance)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Odoo ERP Integration (Optional XML-RPC)
ODOO_URL=http://localhost:8069
ODOO_DB=brightloop_odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
